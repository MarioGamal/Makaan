{
  "name": "@makaan/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/backend/src/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.ts --passWithNoTests",
    "test:unit": "npm run test -- --testPathPattern=tests/unit",
    "test:contract": "npm run test -- --testPathPattern=tests/contract",
    "test:integration": "npm run test -- --testPathPattern=tests/integration",
    "migration:run": "bash ../scripts/migrations.sh run",
    "migration:revert": "bash ../scripts/migrations.sh revert",
    "migration:validate": "bash ../scripts/validate-migrations.sh",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "seed": "DOTENV_CONFIG_PATH=../.env ts-node -r dotenv/config -r tsconfig-paths/register src/database/seed.ts",
    "seed:demo-hosted": "DOTENV_CONFIG_PATH=../.env.demo MAKAAN_ALLOW_HOSTED_DEMO_SEED=1 ts-node -r dotenv/config -r tsconfig-paths/register src/database/seed.ts",
    "demo:totp": "DOTENV_CONFIG_PATH=../.env.demo TS_NODE_FILES=true ts-node -r dotenv/config -r tsconfig-paths/register src/scripts/generate-demo-totp.ts",
    "demo:config:check": "DOTENV_CONFIG_PATH=../.env.demo ts-node -r dotenv/config -r tsconfig-paths/register src/scripts/check-demo-config.ts",
    "reset:demo": "DOTENV_CONFIG_PATH=../.env ts-node -r dotenv/config -r tsconfig-paths/register src/database/reset.ts demo",
    "reset:empty": "DOTENV_CONFIG_PATH=../.env ts-node -r dotenv/config -r tsconfig-paths/register src/database/reset.ts empty"
  },
  "dependencies": {
    "@makaan/shared": "0.1.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ioredis": "^5.10.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "7.8.1",
    "sharp": "^0.34.5",
    "speakeasy": "^2.0.0",
    "twilio": "^5.13.0",
    "typeorm": "0.3.30"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "jest": "29.7.0",
    "prettier": "3.9.5",
    "supertest": "7.1.3",
    "ts-jest": "29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
