# Hosted demonstration only. Copy to .env.demo; never commit the populated file.
APP_MODE=demo
NODE_ENV=production
PORT=4000
PUBLIC_APP_URL=https://your-project.vercel.app

ALLOWED_ORIGINS=https://your-project.vercel.app
TRUSTED_PROXY_CIDRS=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
SELLER_SESSION_IDLE_MINUTES=480
SELLER_SESSION_ABSOLUTE_HOURS=720
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=8
CONTACT_INTENT_TTL_SECONDS=300

DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_TLS_MODE=require
DATABASE_TLS_CA_FILE=
REDIS_URL=rediss://default:password@host:port
REDIS_TLS=true

SESSION_TOKEN_PEPPER=
CSRF_TOKEN_PEPPER=
PHONE_LOOKUP_PEPPER=
FIELD_ENCRYPTION_KEY=

# Demo compromises: the OTP is 123456 and scanning is deterministic.
OTP_PROVIDER=local_fixed
MEDIA_PROVIDER=cloudinary
MALWARE_SCANNER_PROVIDER=deterministic
MAP_PROVIDER=mapbox

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAPBOX_TOKEN=

DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_TOTP_SECRET=

EVIDENCE_RETENTION_DAYS=30
LOG_RETENTION_DAYS=30
LOG_LEVEL=info

NEXT_PUBLIC_API_URL=https://your-project.vercel.app/api/v1
NEXT_PUBLIC_MAP_PROVIDER=mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=
