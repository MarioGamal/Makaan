# Makaan local development configuration. Copy to .env; never use these values in production.
# APP_MODE is authoritative. NODE_ENV is retained only for framework diagnostics.
APP_MODE=local
NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:4000

# Browser/API boundary. Origins are an exact comma-separated allowlist; no wildcards.
ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
SELLER_SESSION_IDLE_MINUTES=480
SELLER_SESSION_ABSOLUTE_HOURS=720
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=8
CONTACT_INTENT_TTL_SECONDS=300
ABUSE_OTP_REQUEST_LIMIT=5
ABUSE_OTP_VERIFICATION_LIMIT=5
ABUSE_ADMIN_LOGIN_LIMIT=5
ABUSE_OWNER_LISTING_SUBMISSION_LIMIT=3
ABUSE_AGENT_LISTING_SUBMISSION_LIMIT=2
ABUSE_UPLOAD_LIMIT=20
ABUSE_CONTACT_LIMIT=10
ABUSE_ASSISTANT_MESSAGE_LIMIT=30

# Docker Compose exposes PostGIS on host port 5433 and Redis on host port 6379.
DATABASE_URL=postgresql://makaan_dev:makaan_dev_password_change_in_production@localhost:5433/makaan_dev
DATABASE_TLS_MODE=disable
DATABASE_TLS_CA_FILE=
REDIS_URL=redis://localhost:6379/0
REDIS_TLS=false

# Development-only secret-shaped values. Generate unique high-entropy values before production.
SESSION_TOKEN_PEPPER=local-development-session-pepper-change-before-production
CSRF_TOKEN_PEPPER=local-development-csrf-pepper-change-before-production
PHONE_LOOKUP_PEPPER=local-development-phone-pepper-change-before-production
FIELD_ENCRYPTION_KEY=local-development-32-byte-base64-key-replace

# Local/test providers exercise every journey without paid accounts or external transmission.
# The fixed local OTP is accepted but must never be logged or returned by the API.
OTP_PROVIDER=local_fixed
LOCAL_FIXED_OTP=123456
MEDIA_PROVIDER=local
LOCAL_MEDIA_ROOT=infrastructure/local-media
MALWARE_SCANNER_PROVIDER=deterministic
MAP_PROVIDER=accessible_local
# Account-free assistant. It calls no external service and needs no key.
ASSISTANT_PROVIDER=deterministic

# Local admin fixture. It is a public development fixture, not a production credential.
LOCAL_ADMIN_EMAIL=admin@makaan.test
LOCAL_ADMIN_PASSWORD=local-admin-password-only
LOCAL_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Policy and retention defaults. Evidence stays private and is deleted after final decision unless held.
EVIDENCE_RETENTION_DAYS=30
LOG_RETENTION_DAYS=90
LOG_LEVEL=debug

# Production-only provider inventory. Leave blank in local mode; APP_MODE=production rejects blanks,
# placeholders, local provider values, insecure transport/cookies, wildcard origins, and untrusted proxies.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=replace-with-production-secret
TWILIO_AUTH_TOKEN=replace-with-production-secret
TWILIO_PHONE_NUMBER=replace-with-production-sender
MEDIA_S3_REGION=replace-with-production-region
MEDIA_S3_BUCKET=replace-with-private-production-bucket
MEDIA_S3_ENDPOINT=https://replace-with-production-object-storage-endpoint
MEDIA_S3_ACCESS_KEY_ID=replace-with-production-secret
MEDIA_S3_SECRET_ACCESS_KEY=replace-with-production-secret
MALWARE_SCANNER_PROVIDER_PRODUCTION=clamav
CLAMAV_HOST=replace-with-production-scanner-host
CLAMAV_PORT=3310
MAPBOX_TOKEN=replace-with-restricted-production-map-token

# Next.js receives only explicitly public map configuration. Local mode needs no token.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_MAP_PROVIDER=accessible_local
NEXT_PUBLIC_MAPBOX_TOKEN=
